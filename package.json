{
  "name": "prateek-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Prateek's personal design system: tokens, React components and a web view.",
  "type": "module",
  "main": "./components/index.mjs",
  "module": "./components/index.mjs",
  "types": "./components/index.d.ts",
  "exports": {
    ".": {
      "types": "./components/index.d.ts",
      "import": "./components/index.mjs"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./components.css": "./components/bundle.css",
    "./bundle.js": "./components/bundle.js",
    "./package.json": "./package.json"
  },
  "files": [
    "tokens",
    "components",
    "DESIGN.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && python3 -m http.server 4173"
  },
  "engines": {
    "node": ">=18"
  }
}
